# Copy to repo-root .env. Compose demo (api + worker) and Settings load this file;
# process env still overrides. LLM lines stay optional (worker only).
DATABASE_URL=postgresql://city:city@postgres:5432/city
AUDIT_ACTOR=demo-operator
# Gemini via Google AI Studio (OpenAI-compatible). Worker reads these; API does not fill opinions.
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.6-flash
# Ops logs for worker (and optional API). Product audit stays in Postgres.
# LOG_LEVEL=INFO
