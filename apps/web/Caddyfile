{
	auto_https off
	admin off
}

# Cloud Run sets PORT. Browser keeps /api; FastAPI has no prefix.
# When API_UPSTREAM is set, entrypoint starts token_proxy on :8090
# (adds Cloud Run ID token → private api). Otherwise :8090 is down → 502.
:{$PORT} {
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8090
	}

	handle {
		root * /usr/share/caddy
		file_server
	}
}
