{
	auto_https off
	admin off
}

# Cloud Run sets PORT. Browser keeps /api; FastAPI has no prefix.
# API_UPSTREAM empty → /api 502 until the api service exists.
:{$PORT} {
	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:http://127.0.0.1:9}
	}

	handle {
		root * /usr/share/caddy
		file_server
	}
}
